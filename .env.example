# ===========================================
# TshirtHub Bangladesh - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Django Settings
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
DB_NAME=tshirthub_bd
DB_USER=postgres
DB_PASSWORD=your-secure-db-password
DB_HOST=localhost
DB_PORT=5432

# Site Configuration
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ===========================================
# Payment Gateway Configuration
# ===========================================

# bKash Payment Gateway (PGW API)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password

# Nagad Payment (if using direct merchant API)
NAGAD_BASE_URL=https://sandbox.mynagad.com:10080/checkout/verify
NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAG_MERCHANT_KEY=your-nagad-merchant-key

# Rocket Payment (if using direct merchant API)
ROCKET_BASE_URL=https://sandbox.rocket.com/api
ROCKET_MERCHANT_ID=your-rocket-merchant-id
ROCKET_API_KEY=your-rocket-api-key

# SSLCommerz (Online Card Payment)
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_MODE=sandbox

# ===========================================
# Email Configuration
# ===========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# ===========================================
# File Storage
# ===========================================
MEDIA_ROOT=./media/
STATIC_ROOT=./static/

# ===========================================
# Redis (Optional - for caching/sessions)
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# Security
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
